# Sensitive values — copy to .env and fill in. NEVER commit .env.

# Groq LLM API key (https://console.groq.com)
GROQ_API_KEY=

# Hugging Face API key (for sentence-transformers model downloads)
HF_API_KEY=

# Optional: AWS CLI profile to use for boto3 calls (defaults to default profile / env credentials)
AWS_PROFILE=

# AgentCore Memory ID — populated from `terraform output memory_id` after terraform apply
MEMORY_ID=

# AgentCore Runtime ARN — populated after `agentcore launch`
AGENT_RUNTIME_ARN=
